# ===============================
# DATABASE CONFIGURATION (PostgreSQL)
# ===============================
DB_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ===============================
# RABBITMQ CONFIGURATION
# ===============================
