# --- Extraction Strategy ---
EXTRACTION_STRATEGY=hybrid

# ── NER Model ──
NER_EXTRACTOR_TYPE=gliner
GLINER_MODEL_NAME=urchade/gliner_medium-v2.1
NER_MODEL_NAME=yashpwr/resume-ner-bert-v2
CONFIDENCE_THRESHOLD=0.6

# ── File Validation ──
MAX_FILE_SIZE_MB=10
MAX_PAGE_COUNT=10

# ── LLM Fallback (Google Gemini) ──
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL_NAME=gemini-3.5-flash
LLM_DAILY_RATE_LIMIT=100

# ── Career Path Agent ──
CAREER_PATH_ENABLED=true
CAREER_PATH_TIMEOUT_SECONDS=45
CAREER_PATH_MAX_RETRIES=1
CAREER_PATH_TEMPERATURE=0.2

# ── Message Queue ──
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_ENABLED=true

# ── Server ──
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Backend API & Database ──
BACKEND_BASE_URL=http://backend-core:8080
KB_WARMUP_TIMEOUT_SECONDS=15
DB_URL=postgresql://postgres:5432/tttn_db
DB_USERNAME=postgres
DB_PASSWORD=password123
CHECKPOINTER_TYPE=postgres

# ── OCR ──
TESSERACT_LANG=eng+vie

# ── LangSmith Tracing ──
LANGSMITH_TRACING=false
LANGSMITH_DISABLE_RUN_COMPRESSION=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=tttn-multi-agent-pipeline
# Set one only when applicable to your LangSmith account.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=your-workspace-id
