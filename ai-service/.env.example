# --- Extraction Strategy ---
EXTRACTION_STRATEGY=hybrid

# ── NER Model ──
NER_EXTRACTOR_TYPE=gliner
GLINER_MODEL_NAME=urchade/gliner_medium-v2.1
NER_MODEL_NAME=yashpwr/resume-ner-bert-v2
CONFIDENCE_THRESHOLD=0.6

# ── File Validation ──
MAX_FILE_SIZE_MB=10
MAX_PAGE_COUNT=10

# ── LLM Fallback (Google Gemini) ──
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL_NAME=gemini-3.5-flash
LLM_DAILY_RATE_LIMIT=100

# ── Career Path Agent ──
CAREER_PATH_ENABLED=true
CAREER_PATH_TIMEOUT_SECONDS=45
CAREER_PATH_MAX_RETRIES=1
CAREER_PATH_TEMPERATURE=0.2

# ── Message Queue ──
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_ENABLED=true

# ── Server ──
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Backend API & Database ──
BACKEND_BASE_URL=http://localhost:8080
DB_URL=jdbc:postgresql://localhost:5432/tttn
DB_USERNAME=postgres
DB_PASSWORD=password123
CHECKPOINTER_TYPE=memory

# ── OCR ──
TESSERACT_LANG=eng+vie

# ── LangSmith / LangChain Tracing ──
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=tttn-multi-agent-pipeline
